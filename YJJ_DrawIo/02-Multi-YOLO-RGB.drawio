        <mxCell id="VFSQb5fpk1JRIzxNaWi4-29" parent="VFSQb5fpk1JRIzxNaWi4-34" style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;align=left;spacingLeft=5;verticalAlign=top;spacingTop=0;fillColor=#ffffff;strokeColor=#999999;spacing=0;" value="&lt;div&gt;&lt;b&gt;NME评价标准是否一致？&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="40" width="420" as="geometry" />
        </mxCell>
        <mxCell id="VFSQb5fpk1JRIzxNaWi4-30" parent="VFSQb5fpk1JRIzxNaWi4-34" style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;align=left;spacingLeft=0;verticalAlign=top;spacingTop=-4;fillColor=none;strokeColor=#999999;dashed=1;fontSize=11;fontColor=#666666;fontStyle=1" value="&lt;div&gt;&lt;div&gt;&lt;font color=&quot;#000000&quot; style=&quot;font-size: 9px;&quot;&gt;GUI计算NME&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font color=&quot;#000000&quot; style=&quot;font-size: 9px;&quot;&gt;common_rows = [row for row in rows&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font color=&quot;#000000&quot; style=&quot;font-size: 9px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;if cls._is_true(row.get(&quot;common_matched&quot;))]&amp;nbsp; &amp;nbsp;# ← 89-90 先过滤成 66 行&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font color=&quot;#000000&quot; style=&quot;font-size: 9px;&quot;&gt;...&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font color=&quot;#000000&quot; style=&quot;font-size: 9px;&quot;&gt;rgbd_nmes = [cls._valid_number(row.get(&quot;rgbd_nme&quot;)) for row in common_rows]&amp;nbsp; # ← 92-93&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font color=&quot;#000000&quot; style=&quot;font-size: 9px;&quot;&gt;rgbd_mean = mean(rgbd_nmes) if rgbd_nmes else None&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;# ← 98 只在这 66 行上求均值&lt;/font&gt;&lt;/div&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="92" width="420" y="48.40999999999997" as="geometry" />
        </mxCell>
        <mxCell id="VFSQb5fpk1JRIzxNaWi4-31" parent="VFSQb5fpk1JRIzxNaWi4-34" style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;align=left;spacingLeft=0;verticalAlign=top;spacingTop=-4;fillColor=none;strokeColor=#999999;dashed=1;fontSize=11;fontColor=#666666;fontStyle=1" value="&lt;div&gt;&lt;font color=&quot;#000000&quot; style=&quot;font-size: 9px;&quot;&gt;命令行计算NME&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;div&gt;&lt;font color=&quot;#000000&quot; size=&quot;1&quot;&gt;self_rows = [r for r in rows if bool(r[f&quot;{name}_matched&quot;])]&amp;nbsp; &amp;nbsp; &amp;nbsp; # ← 237：自家命中 101 行&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font color=&quot;#000000&quot; size=&quot;1&quot;&gt;entry = {&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font color=&quot;#000000&quot; size=&quot;1&quot;&gt;&amp;nbsp; &amp;nbsp; ...&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font color=&quot;#000000&quot; size=&quot;1&quot;&gt;&amp;nbsp; &amp;nbsp; &quot;nme_self&quot;:&amp;nbsp; &amp;nbsp;mean_of([r[f&quot;{name}_nme&quot;] for r in self_rows]),&amp;nbsp; &amp;nbsp;# ← 243：101 行&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font color=&quot;#000000&quot; size=&quot;1&quot;&gt;&amp;nbsp; &amp;nbsp; &quot;nme_common&quot;: mean_of([r[f&quot;{name}_nme&quot;] for r in common]),&amp;nbsp; &amp;nbsp; &amp;nbsp; # ← 244：共同集（也是 101）&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font color=&quot;#000000&quot; size=&quot;1&quot;&gt;}&lt;/font&gt;&lt;/div&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="102" width="480" y="158.40999999999997" as="geometry" />
        </mxCell>
        <mxCell id="CPBfa6v9xM4nsS8v_3wW-10" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;align=left;spacingLeft=0;verticalAlign=top;spacingTop=-4;fillColor=none;strokeColor=#999999;dashed=1;fontSize=11;fontColor=#666666;fontStyle=1" value="&lt;div&gt;&lt;div&gt;&lt;font color=&quot;#000000&quot; style=&quot;font-size: 9px;&quot;&gt;cd /d H:\YJJ\Yolo_RGBD\MultiYoloRGB&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font color=&quot;#000000&quot; style=&quot;font-size: 9px;&quot;&gt;.venv\Scripts\python.exe H:\YJJ\Yolo_RGBD\yolov8_rgbd_detection\YJJ_Pose_Scripts\03_train\train_rgbd_pose.py --data H:\YJJ\Yolo_RGBD\Resource\session1_200146\dataset\hand\rgbd\data_rgbd.yaml --weights H:\YJJ\Yolo_RGBD\MultiYoloRGB\yolo11_4ch\yolo11n-pose_4ch.pt --fliplr 0.0 --patience 20 --name train_yolo11_rgbd_4ch&lt;/font&gt;&lt;/div&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;" vertex="1">

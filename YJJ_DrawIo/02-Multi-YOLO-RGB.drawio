        </mxCell>
        <mxCell id="24VguRakYNypaYMbWFzB-237" parent="1NkrRQL5JDErNk1F1o5U-1" style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;align=center;spacingLeft=0;verticalAlign=top;spacingTop=-4;fillColor=none;strokeColor=#999999;dashed=1;fontSize=11;fontColor=#666666;fontStyle=1" value="&lt;div&gt;&lt;font style=&quot;color: light-dark(rgb(0, 0, 255), rgb(237, 237, 237));&quot;&gt;继续排除 G2 内部的 8 个通道&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;color: rgb(0, 0, 0);&quot;&gt;&lt;div&gt;cd /d H:\YJJ\Yolo_RGBD\MultiYoloRGB&lt;/div&gt;&lt;div&gt;.venv\Scripts\python.exe ablate_l1_g2_detail.py --groups 4 --target-group 2 --base-keep 0.50 --restore-keep 1.00 --mode both&lt;/div&gt;&lt;/font&gt;&lt;/div&gt;" vertex="1">

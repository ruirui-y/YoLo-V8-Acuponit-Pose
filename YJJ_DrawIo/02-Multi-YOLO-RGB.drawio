        <mxCell id="rISMqpWTSaIjBTX3ntEy-13" parent="JvtbEcOUj91b7LXbszsn-1" style="shape=image;verticalLabelPosition=bottom;labelBackgroundColor=default;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/png,;" value="" vertex="1">
          <mxGeometry height="616.57" width="668.67" x="1100" y="1260" as="geometry" />

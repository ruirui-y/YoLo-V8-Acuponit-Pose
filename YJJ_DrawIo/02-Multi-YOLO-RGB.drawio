        <mxCell id="24VguRakYNypaYMbWFzB-218" parent="1NkrRQL5JDErNk1F1o5U-1" style="shape=image;verticalLabelPosition=bottom;labelBackgroundColor=default;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/png,;" value="" vertex="1">

        <mxCell id="rISMqpWTSaIjBTX3ntEy-24" edge="1" parent="JvtbEcOUj91b7LXbszsn-1" source="rISMqpWTSaIjBTX3ntEy-15" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" target="rISMqpWTSaIjBTX3ntEy-19">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="rISMqpWTSaIjBTX3ntEy-15" parent="JvtbEcOUj91b7LXbszsn-1" style="shape=image;verticalLabelPosition=bottom;labelBackgroundColor=default;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/png,;" value="" vertex="1">
          <mxGeometry height="253.58" width="668.67" x="1100" y="2072" as="geometry" />
        </mxCell>
        <mxCell id="rISMqpWTSaIjBTX3ntEy-25" edge="1" parent="JvtbEcOUj91b7LXbszsn-1" source="rISMqpWTSaIjBTX3ntEy-16" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" target="rISMqpWTSaIjBTX3ntEy-19">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="rISMqpWTSaIjBTX3ntEy-16" parent="JvtbEcOUj91b7LXbszsn-1" style="shape=image;verticalLabelPosition=bottom;labelBackgroundColor=default;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/png,;" value="" vertex="1">
          <mxGeometry height="289.08" width="668.67" x="1100" y="2490" as="geometry" />
        </mxCell>
        <mxCell id="rISMqpWTSaIjBTX3ntEy-19" parent="JvtbEcOUj91b7LXbszsn-1" style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;align=left;spacingLeft=8;verticalAlign=top;spacingTop=4;fillColor=#dae8fc;strokeColor=#6c8ebf;" value="&lt;div&gt;&lt;b&gt;结论&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;&lt;br&gt;&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;1 深度细节不影响结果&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;&amp;nbsp; 模糊、只留 4 个等级、错位 16 像素 → 全在 ±2%&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;&lt;br&gt;&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;2 数值压太低一定变差&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;&amp;nbsp; 清零 +53%、全填 1 +52%、只留边缘 +42%、&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;&amp;nbsp; 压暗 +26%、−51 +21%&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;&lt;br&gt;&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;3 抬数值 / 反转 / 拉平 → 稳定变好&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;&amp;nbsp; 反转 −15.4%、+102 −13%、填平均值 −12.5%、&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;&amp;nbsp; 提亮 −11.8%、填 255 −9.3%、填 128 −9.0%&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;&lt;br&gt;&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;4 相同改动放到颜色通道无效&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;&amp;nbsp; 颜色 +51 −1.3%；颜色反转直接崩（命中 11 张）&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;&amp;nbsp; → 效应只在第 4 通道&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;&lt;br&gt;&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;5 v8 正好相反&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;&amp;nbsp; 11 上有效的改动，v8 上多为变差&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;&lt;br&gt;&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;未解：&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;&amp;nbsp; 上下镜像 −15.5%（左右镜像却 +8.7%）&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;&amp;nbsp; 为什么&quot;反转&quot;和&quot;抬高&quot;两种不同方向都能变好&lt;/b&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="300" width="290" x="2570" y="1418.29" as="geometry" />
        </mxCell>
      </root>

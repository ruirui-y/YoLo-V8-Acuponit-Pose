        <mxCell id="VFSQb5fpk1JRIzxNaWi4-34" connectable="0" parent="_TVjmWFdlfLV95gu-don-1" style="group;fillColor=#dae8fc;strokeColor=#6c8ebf;" value="" vertex="1">

        </mxCell>
        <mxCell id="ksPBZGEtHLths1o5VsqG-15" edge="1" parent="ELrkmDf1NHWVyGYEqN6C-4" source="ksPBZGEtHLths1o5VsqG-7" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" target="ksPBZGEtHLths1o5VsqG-14">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ksPBZGEtHLths1o5VsqG-16" edge="1" parent="ELrkmDf1NHWVyGYEqN6C-4" source="ksPBZGEtHLths1o5VsqG-8" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" target="ksPBZGEtHLths1o5VsqG-14">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ksPBZGEtHLths1o5VsqG-19" parent="ELrkmDf1NHWVyGYEqN6C-4" style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;align=left;spacingLeft=5;verticalAlign=top;spacingTop=0;fillColor=#ffffff;strokeColor=#999999;spacing=0;" value="&lt;div&gt;&lt;b&gt;yolo11n-pose 胜出：定位最准（NME 0.0697）、速度最快（23.68 ms）。&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;&lt;br&gt;&lt;/b&gt;&lt;/div&gt;&lt;div&gt;yolo26n-pose 反而最差（NME 0.1095），&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;与它&quot;最新版本&quot;的定位相反。&lt;/span&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="70" width="310" x="2860" y="500" as="geometry" />
        </mxCell>
        <mxCell id="ksPBZGEtHLths1o5VsqG-22" parent="ELrkmDf1NHWVyGYEqN6C-4" style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;align=left;spacingLeft=5;verticalAlign=top;spacingTop=0;fillColor=#ffffff;strokeColor=#999999;spacing=0;" value="&lt;div&gt;&lt;b&gt;分开对比&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;命中率： 三代都是 99%~100%&amp;nbsp; → 覆盖率不是区分点&lt;/div&gt;&lt;div&gt;&lt;div&gt;定位精度（NME 越小越好）：11 (0.0697) &amp;lt; v8 (0.0819) &amp;lt; 26 (0.1095)&lt;/div&gt;&lt;div&gt;推理耗时（越小越快）：11 (23.7ms) &amp;lt; 26 (26.5ms) &amp;lt; v8 (35.7ms)&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;→ 11 又快又准，v8 最慢，26 最不准&lt;/div&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="98" width="340" x="2860" y="596" as="geometry" />
        </mxCell>
        <mxCell id="ksPBZGEtHLths1o5VsqG-48" parent="ELrkmDf1NHWVyGYEqN6C-4" style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;align=left;spacingLeft=5;verticalAlign=top;spacingTop=0;fillColor=#ffffff;strokeColor=#999999;spacing=0;" value="&lt;div&gt;&lt;div&gt;&lt;b&gt;K0~K6 逐点结论&lt;/b&gt;&lt;/div&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;div&gt;K1 / K3：三代都差（91~160 px）&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;→ 这两个点本身难，不是模型的问题&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;K4 / K5：11 明显最优（33.7 / 25.3 px）&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;→ 11 的整体优势主要来自这两个点&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;K0 / K2 / K6：v8 最好&lt;/div&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="120" width="310" x="2860" y="727" as="geometry" />
        </mxCell>
        <mxCell id="ksPBZGEtHLths1o5VsqG-51" parent="ELrkmDf1NHWVyGYEqN6C-4" style="shape=image;verticalLabelPosition=bottom;labelBackgroundColor=default;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/png,;" value="" vertex="1">
          <mxGeometry height="190" width="202.78" x="2860" y="880" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>

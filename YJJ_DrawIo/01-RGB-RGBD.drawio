          <mxGeometry height="36.5" width="240" x="1800" y="470" as="geometry" />
        </mxCell>
        <mxCell id="ELrkmDf1NHWVyGYEqN6C-55" edge="1" parent="ELrkmDf1NHWVyGYEqN6C-4" source="ELrkmDf1NHWVyGYEqN6C-36" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" target="ELrkmDf1NHWVyGYEqN6C-43">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ELrkmDf1NHWVyGYEqN6C-36" parent="ELrkmDf1NHWVyGYEqN6C-4" style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;align=left;spacingLeft=5;verticalAlign=top;spacingTop=0;fillColor=#ffffff;strokeColor=#999999;spacing=0;" value="&lt;p&gt;&lt;b&gt;Depth 消融测试：确认第四通道有没有被使用&lt;/b&gt;&lt;/p&gt;&lt;p&gt;不改变 RGBD 模型，只替换输入的 Depth 内容。&lt;/p&gt;&lt;div&gt;&lt;table&gt;&lt;tbody&gt;&lt;tr&gt;&lt;th&gt;&lt;p&gt;Depth 类型&lt;/p&gt;&lt;/th&gt;&lt;th&gt;&lt;p&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;Pose mAP50-95&lt;/p&gt;&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;p&gt;真实 Depth&lt;/p&gt;&lt;/td&gt;&lt;td&gt;&lt;p&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;0.9882&lt;/p&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;p&gt;全零 Depth&lt;/p&gt;&lt;/td&gt;&lt;td&gt;&lt;p&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;0.9950&lt;/p&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;p&gt;换成其他图片的 Depth&lt;/p&gt;&lt;/td&gt;&lt;td&gt;&lt;p&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;0.9868&lt;/p&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;p&gt;打乱 Depth 像素位置&lt;/p&gt;&lt;/td&gt;&lt;td&gt;&lt;p&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;0.1348&lt;/p&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/tbody&gt;&lt;/table&gt;&lt;/div&gt;&lt;p&gt;发现：模型确实使用了第四通道，并且很依赖 Depth 的空间结构，但尚不能证明它利用了正确的三维几何信息。&lt;/p&gt;" vertex="1">
          <mxGeometry height="280" width="490" x="2300" y="88.25" as="geometry" />
        </mxCell>
        <mxCell id="ELrkmDf1NHWVyGYEqN6C-56" edge="1" parent="ELrkmDf1NHWVyGYEqN6C-4" source="ELrkmDf1NHWVyGYEqN6C-41" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" target="ELrkmDf1NHWVyGYEqN6C-43">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ELrkmDf1NHWVyGYEqN6C-41" parent="ELrkmDf1NHWVyGYEqN6C-4" style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;align=left;spacingLeft=5;verticalAlign=top;spacingTop=0;fillColor=#ffffff;strokeColor=#999999;spacing=0;" value="&lt;p&gt;&lt;b&gt;引入 NME，重新比较关键点的位置误差&lt;/b&gt;&lt;/p&gt;&lt;p&gt;还是原来同一个人的 12 张测试图片。&lt;/p&gt;&lt;ul&gt;&lt;li&gt;&lt;p&gt;RGB NME：0.019898&lt;/p&gt;&lt;/li&gt;&lt;li&gt;&lt;p&gt;RGBD NME：0.045549&lt;/p&gt;&lt;/li&gt;&lt;li&gt;&lt;p&gt;RGB 赢：12 / 12&lt;/p&gt;&lt;/li&gt;&lt;/ul&gt;&lt;p&gt;发现：按照关键点与真实标签的距离来算，RGB 仍然更准。&lt;/p&gt;" vertex="1">
          <mxGeometry height="140" width="490" x="2300" y="418.25" as="geometry" />
        </mxCell>
        <mxCell id="ELrkmDf1NHWVyGYEqN6C-60" edge="1" parent="ELrkmDf1NHWVyGYEqN6C-4" source="ELrkmDf1NHWVyGYEqN6C-43" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" target="ELrkmDf1NHWVyGYEqN6C-59">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
